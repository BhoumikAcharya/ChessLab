{
  "name": "chesslab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-engine.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "verify:dist": "node scripts/verify-dist.mjs",
    "release": "npm test && npm run lint && npm run build && node scripts/package-release.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "stockfish": "16.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
